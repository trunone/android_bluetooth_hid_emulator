<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extended Keyboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_gravity="center_horizontal" />

        <!-- Modifier Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ToggleButton
                android:id="@+id/dialog_btn_mod_ctrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOff="@string/key_ctrl"
                android:textOn="@string/key_ctrl"
                android:textSize="12sp" />

            <ToggleButton
                android:id="@+id/dialog_btn_mod_alt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOff="@string/key_alt"
                android:textOn="@string/key_alt"
                android:textSize="12sp" />

            <ToggleButton
                android:id="@+id/dialog_btn_mod_shift"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOff="@string/key_shift"
                android:textOn="@string/key_shift"
                android:textSize="12sp" />

            <ToggleButton
                android:id="@+id/dialog_btn_mod_win"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textOff="@string/key_win"
                android:textOn="@string/key_win"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Function Keys Section (2 rows of 6) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Function Keys"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <Button android:id="@+id/dialog_btn_f1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F1" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F2" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F3" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F4" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F5" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F6" android:textSize="11sp" android:padding="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button android:id="@+id/dialog_btn_f7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F7" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F8" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f9" android:layout_width="0dp" android:layout_height="wrap_content" android:text="F9" android:layout_weight="1" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F10" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f11" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F11" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_f12" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="F12" android:textSize="11sp" android:padding="0dp"/>
        </LinearLayout>

        <!-- Special Navigation Keys (2 rows of 4) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Special Keys"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <Button android:id="@+id/dialog_btn_esc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_esc" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_tab" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_tab" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_ins" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_ins" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_del" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_del" android:textSize="11sp" android:padding="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button android:id="@+id/dialog_btn_home" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_home" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_end" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_pgup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_pgup" android:textSize="11sp" android:padding="0dp"/>
            <Button android:id="@+id/dialog_btn_pgdn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/key_pgdn" android:textSize="11sp" android:padding="0dp"/>
        </LinearLayout>

        <!-- Arrow Keys Pad -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arrow Keys"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/dialog_btn_arrow_up"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/key_up"
                android:textSize="16sp"
                android:padding="0dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/dialog_btn_arrow_left"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/key_left"
                    android:textSize="16sp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/dialog_btn_arrow_down"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/key_down"
                    android:textSize="16sp"
                    android:padding="0dp" />

                <Button
                    android:id="@+id/dialog_btn_arrow_right"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/key_right"
                    android:textSize="16sp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
